xdg_wm_base#1 = wl_registry#1.bind
xdg_wm_dialog_v1#1 = wl_registry#1.bind
zwp_linux_dmabuf_v1#1 = wl_registry#1.bind
  <- modifier(<the renderer's formats>)
zxdg_decoration_manager_v1#1 = wl_registry#1.bind
zxdg_output_manager_v1#1 = wl_registry#2.bind
  -> get_xdg_output(new zxdg_output_v1#1, wl_output#3)
  -> get_xdg_output(new zxdg_output_v1#2, wl_output#4)
zxdg_output_v1#1 = zxdg_output_manager_v1#1.get_xdg_output
  <- logical_position(0, 0), before wl_output#3.done[2]
  <- logical_size(2560, 1440), before wl_output#3.done[2]
  <- name("HEADLESS-1"), before wl_output#3.done[2]
  <- description("Yuna - Virtual output - HEADLESS-1"), before wl_output#3.done[2]
zxdg_output_v1#2 = zxdg_output_manager_v1#1.get_xdg_output
  <- logical_position(2560, 0), before wl_output#4.done[2]
  <- logical_size(1920, 1080), before wl_output#4.done[2]
  <- name("HEADLESS-2"), before wl_output#4.done[2]
