  <- global(name of zxdg_output_manager_v1#1, "zxdg_output_manager_v1", 3)
  -> bind(name of wl_output#3, "wl_output", 4, new wl_output#3)
  -> bind(name of zxdg_output_manager_v1#1, "zxdg_output_manager_v1", 3, new zxdg_output_manager_v1#1)
  <- global(name of wl_output#4, "wl_output", 4)
  -> bind(name of wl_output#4, "wl_output", 4, new wl_output#4)
  <- global_remove(name of wl_output#4)
wl_seat#1 = wl_registry#1.bind
  <- capabilities(2)
wl_shm#1 = wl_registry#1.bind
  <- format(0)
  <- format(1)
wl_subcompositor#1 = wl_registry#1.bind
wp_fractional_scale_manager_v1#1 = wl_registry#1.bind
wp_presentation#1 = wl_registry#1.bind
  <- clock_id(1)
