# input on the manual clock: each client's objects by interface and rank, each with its own messages in order, and the event
# of another object that follows one where the protocol requires it; serials named by the event that carried them; times in ms from the earliest frame callback
client input
wl_buffer#1 = wl_shm_pool#1.create_buffer
  <- release()
wl_buffer#2 = wl_shm_pool#2.create_buffer
  <- release()
wl_buffer#3 = wl_shm_pool#3.create_buffer
wl_buffer#4 = wl_shm_pool#4.create_buffer
wl_callback#1 = wl_surface#1.frame
  <- done(t+0ms)
  <- delete_id
wl_callback#2 = wl_surface#1.frame
  <- done(t+17ms)
  <- delete_id
wl_callback#3 = wl_surface#2.frame
  <- done(t+0ms)
  <- delete_id
wl_callback#4 = wl_surface#2.frame
  <- done(t+17ms)
  <- delete_id
wl_compositor#1 = wl_registry#1.bind
  -> create_surface(new wl_surface#1)
  -> create_surface(new wl_surface#2)
wl_data_device#1 = wl_data_device_manager#1.get_data_device
  <- selection(null)
wl_data_device_manager#1 = wl_registry#2.bind
  -> get_data_device(new wl_data_device#1, wl_seat#2)
wl_display#1
  -> get_registry(new wl_registry#1)
  -> get_registry(new wl_registry#2)
wl_keyboard#1 = wl_seat#2.get_keyboard
  <- keymap(1, <fd>, <keymap size>)
  <- repeat_info(25, 600)
  <- enter(serial, wl_surface#2, [])
  <- modifiers(serial of wl_keyboard#1.enter[1], 0, 0, 0, 0)
  <- leave(serial, wl_surface#2)
  <- enter(serial of wl_keyboard#1.leave[1], wl_surface#1, [])
  <- modifiers(serial of wl_keyboard#1.leave[1], 0, 0, 0, 0)
  <- key(serial, t+40ms, 42, 1)
  <- modifiers(serial of wl_keyboard#1.key[1], 1, 0, 0, 0)
  <- key(serial, t+45ms, 30, 1)
  <- key(serial, t+50ms, 30, 0)
  <- key(serial, t+55ms, 42, 0)
  <- modifiers(serial of wl_keyboard#1.key[4], 0, 0, 0, 0)
wl_output#1 = wl_registry#1.bind
  <- geometry(0, 0, 0, 0, 0, "Yuna", "Virtual output", 0)
  <- mode(3, 1920, 1080, 60000)
  <- name("HEADLESS-1")
  <- description("Yuna - Virtual output - HEADLESS-1")
  <- scale(1)
  <- done()
wl_pointer#1 = wl_seat#2.get_pointer
  <- enter(serial, wl_surface#1, 10, 10)
  <- frame()
  <- motion(t+25ms, 30.5, 20.25)
  <- frame()
  <- button(serial, t+30ms, 272, 1)
  <- frame()
  <- button(serial, t+35ms, 272, 0)
  <- frame()
  <- leave(serial, wl_surface#1)
  <- frame()
  <- enter(serial of wl_pointer#1.leave[1], wl_surface#2, 10, 10)
  <- frame()
  <- leave(serial, wl_surface#2)
  <- frame()
wl_registry#1 = wl_display#1.get_registry
  <- global(name of ext_image_copy_capture_manager_v1, "ext_image_copy_capture_manager_v1", 1)
  <- global(name of ext_output_image_capture_source_manager_v1, "ext_output_image_capture_source_manager_v1", 1)
  <- global(name of wl_compositor#1, "wl_compositor", 6)
  <- global(name of wl_data_device_manager, "wl_data_device_manager", 3)
  <- global(name of wl_output#1, "wl_output", 4)
  <- global(name of wl_seat#1, "wl_seat", 9)
  <- global(name of wl_shm#1, "wl_shm", 2)
  <- global(name of wl_subcompositor#1, "wl_subcompositor", 1)
  <- global(name of wp_color_manager_v1, "wp_color_manager_v1", 3)
  <- global(name of wp_cursor_shape_manager_v1, "wp_cursor_shape_manager_v1", 2)
  <- global(name of wp_fractional_scale_manager_v1#1, "wp_fractional_scale_manager_v1", 1)
  <- global(name of wp_presentation#1, "wp_presentation", 2)
  <- global(name of wp_viewporter#1, "wp_viewporter", 1)
  <- global(name of xdg_activation_v1#1, "xdg_activation_v1", 1)
  <- global(name of xdg_wm_base#1, "xdg_wm_base", 7)
  <- global(name of xdg_wm_dialog_v1#1, "xdg_wm_dialog_v1", 1)
  <- global(name of zwlr_screencopy_manager_v1, "zwlr_screencopy_manager_v1", 3)
  <- global(name of zwlr_virtual_pointer_manager_v1, "zwlr_virtual_pointer_manager_v1", 2)
  <- global(name of zwp_linux_dmabuf_v1#1, "zwp_linux_dmabuf_v1", 6)
  <- global(name of zwp_primary_selection_device_manager_v1, "zwp_primary_selection_device_manager_v1", 1)
  <- global(name of zwp_text_input_manager_v3, "zwp_text_input_manager_v3", 1)
  <- global(name of zwp_virtual_keyboard_manager_v1, "zwp_virtual_keyboard_manager_v1", 1)
  <- global(name of zxdg_decoration_manager_v1#1, "zxdg_decoration_manager_v1", 2)
  <- global(name of zxdg_output_manager_v1, "zxdg_output_manager_v1", 3)
  -> bind(name of wl_compositor#1, "wl_compositor", 6, new wl_compositor#1)
  -> bind(name of wl_output#1, "wl_output", 4, new wl_output#1)
  -> bind(name of wl_seat#1, "wl_seat", 1, new wl_seat#1)
  -> bind(name of wl_shm#1, "wl_shm", 1, new wl_shm#1)
  -> bind(name of wl_subcompositor#1, "wl_subcompositor", 1, new wl_subcompositor#1)
  -> bind(name of wp_fractional_scale_manager_v1#1, "wp_fractional_scale_manager_v1", 1, new wp_fractional_scale_manager_v1#1)
  -> bind(name of wp_presentation#1, "wp_presentation", 1, new wp_presentation#1)
  -> bind(name of wp_viewporter#1, "wp_viewporter", 1, new wp_viewporter#1)
  -> bind(name of xdg_activation_v1#1, "xdg_activation_v1", 1, new xdg_activation_v1#1)
  -> bind(name of xdg_wm_base#1, "xdg_wm_base", 7, new xdg_wm_base#1)
  -> bind(name of xdg_wm_dialog_v1#1, "xdg_wm_dialog_v1", 1, new xdg_wm_dialog_v1#1)
  -> bind(name of zwp_linux_dmabuf_v1#1, "zwp_linux_dmabuf_v1", 3, new zwp_linux_dmabuf_v1#1)
  -> bind(name of zxdg_decoration_manager_v1#1, "zxdg_decoration_manager_v1", 1, new zxdg_decoration_manager_v1#1)
wl_registry#2 = wl_display#1.get_registry
  <- global(name of ext_image_copy_capture_manager_v1, "ext_image_copy_capture_manager_v1", 1)
  <- global(name of ext_output_image_capture_source_manager_v1, "ext_output_image_capture_source_manager_v1", 1)
  <- global(name of wl_compositor, "wl_compositor", 6)
  <- global(name of wl_data_device_manager#1, "wl_data_device_manager", 3)
  <- global(name of wl_output, "wl_output", 4)
  <- global(name of wl_seat#2, "wl_seat", 9)
  <- global(name of wl_shm, "wl_shm", 2)
  <- global(name of wl_subcompositor, "wl_subcompositor", 1)
  <- global(name of wp_color_manager_v1, "wp_color_manager_v1", 3)
  <- global(name of wp_cursor_shape_manager_v1#1, "wp_cursor_shape_manager_v1", 2)
  <- global(name of wp_fractional_scale_manager_v1, "wp_fractional_scale_manager_v1", 1)
  <- global(name of wp_presentation, "wp_presentation", 2)
  <- global(name of wp_viewporter, "wp_viewporter", 1)
  <- global(name of xdg_activation_v1, "xdg_activation_v1", 1)
  <- global(name of xdg_wm_base, "xdg_wm_base", 7)
  <- global(name of xdg_wm_dialog_v1, "xdg_wm_dialog_v1", 1)
  <- global(name of zwlr_screencopy_manager_v1, "zwlr_screencopy_manager_v1", 3)
  <- global(name of zwlr_virtual_pointer_manager_v1, "zwlr_virtual_pointer_manager_v1", 2)
  <- global(name of zwp_linux_dmabuf_v1, "zwp_linux_dmabuf_v1", 6)
  <- global(name of zwp_primary_selection_device_manager_v1, "zwp_primary_selection_device_manager_v1", 1)
  <- global(name of zwp_text_input_manager_v3#1, "zwp_text_input_manager_v3", 1)
  <- global(name of zwp_virtual_keyboard_manager_v1, "zwp_virtual_keyboard_manager_v1", 1)
  <- global(name of zxdg_decoration_manager_v1, "zxdg_decoration_manager_v1", 2)
  <- global(name of zxdg_output_manager_v1, "zxdg_output_manager_v1", 3)
  -> bind(name of wl_data_device_manager#1, "wl_data_device_manager", 3, new wl_data_device_manager#1)
  -> bind(name of wl_seat#2, "wl_seat", 8, new wl_seat#2)
  -> bind(name of wp_cursor_shape_manager_v1#1, "wp_cursor_shape_manager_v1", 1, new wp_cursor_shape_manager_v1#1)
  -> bind(name of zwp_text_input_manager_v3#1, "zwp_text_input_manager_v3", 1, new zwp_text_input_manager_v3#1)
wl_seat#1 = wl_registry#1.bind
  <- capabilities(3)
wl_seat#2 = wl_registry#2.bind
  <- name("agent-2")
  <- capabilities(3)
  -> get_pointer(new wl_pointer#1)
  -> get_keyboard(new wl_keyboard#1)
wl_shm#1 = wl_registry#1.bind
  <- format(0)
  <- format(1)
  -> create_pool(new wl_shm_pool#1, <fd>, 3923712)
  -> create_pool(new wl_shm_pool#2, <fd>, 3923712)
  -> create_pool(new wl_shm_pool#3, <fd>, 3923712)
  -> create_pool(new wl_shm_pool#4, <fd>, 3923712)
wl_shm_pool#1 = wl_shm#1.create_pool
  -> create_buffer(new wl_buffer#1, 0, 936, 1048, 3744, 0)
  -> destroy()
  <- delete_id
wl_shm_pool#2 = wl_shm#1.create_pool
  -> create_buffer(new wl_buffer#2, 0, 936, 1048, 3744, 0)
  -> destroy()
  <- delete_id
wl_shm_pool#3 = wl_shm#1.create_pool
  -> create_buffer(new wl_buffer#3, 0, 936, 1048, 3744, 0)
  -> destroy()
  <- delete_id
wl_shm_pool#4 = wl_shm#1.create_pool
  -> create_buffer(new wl_buffer#4, 0, 936, 1048, 3744, 0)
  -> destroy()
  <- delete_id
wl_subcompositor#1 = wl_registry#1.bind
wl_surface#1 = wl_compositor#1.create_surface
  -> commit()
  -> attach(wl_buffer#1, 0, 0)
  -> damage_buffer(0, 0, 936, 1048)
  -> frame(new wl_callback#1)
  -> commit()
  <- enter(wl_output#1)
  -> attach(wl_buffer#3, 0, 0)
  -> damage_buffer(0, 0, 936, 1048)
  -> frame(new wl_callback#2)
  -> commit()
wl_surface#2 = wl_compositor#1.create_surface
  -> commit()
  -> attach(wl_buffer#2, 0, 0)
  -> damage_buffer(0, 0, 936, 1048)
  -> frame(new wl_callback#3)
  -> commit()
  <- enter(wl_output#1)
  -> attach(wl_buffer#4, 0, 0)
  -> damage_buffer(0, 0, 936, 1048)
  -> frame(new wl_callback#4)
  -> commit()
wp_cursor_shape_device_v1#1 = wp_cursor_shape_manager_v1#1.get_pointer
wp_cursor_shape_manager_v1#1 = wl_registry#2.bind
  -> get_pointer(new wp_cursor_shape_device_v1#1, wl_pointer#1)
wp_fractional_scale_manager_v1#1 = wl_registry#1.bind
wp_presentation#1 = wl_registry#1.bind
  <- clock_id(1)
wp_viewporter#1 = wl_registry#1.bind
xdg_activation_v1#1 = wl_registry#1.bind
xdg_surface#1 = xdg_wm_base#1.get_xdg_surface
  -> get_toplevel(new xdg_toplevel#1)
  <- configure(serial)
  -> ack_configure(serial of xdg_surface#1.configure[1])
  <- configure(serial)
xdg_surface#2 = xdg_wm_base#1.get_xdg_surface
  -> get_toplevel(new xdg_toplevel#2)
  <- configure(serial)
  -> ack_configure(serial of xdg_surface#2.configure[1])
  <- configure(serial)
  -> ack_configure(serial of xdg_surface#2.configure[2])
  <- configure(serial)
xdg_toplevel#1 = xdg_surface#1.get_toplevel
  <- configure_bounds(0, 0), before xdg_surface#1.configure[1]
  <- wm_capabilities([1, 2, 3, 4]), before xdg_surface#1.configure[1]
  <- configure(936, 1048, [5, 6, 7, 8]), before xdg_surface#1.configure[1]
  <- configure(936, 1048, [4, 5, 6, 7, 8]), before xdg_surface#1.configure[2]
xdg_toplevel#2 = xdg_surface#2.get_toplevel
  <- configure_bounds(0, 0), before xdg_surface#2.configure[1]
  <- wm_capabilities([1, 2, 3, 4]), before xdg_surface#2.configure[1]
  <- configure(936, 1048, [5, 6, 7, 8]), before xdg_surface#2.configure[1]
  <- configure(936, 1048, [4, 5, 6, 7, 8]), before xdg_surface#2.configure[2]
  <- configure(936, 1048, [5, 6, 7, 8]), before xdg_surface#2.configure[3]
xdg_wm_base#1 = wl_registry#1.bind
  -> get_xdg_surface(new xdg_surface#1, wl_surface#1)
  -> get_xdg_surface(new xdg_surface#2, wl_surface#2)
xdg_wm_dialog_v1#1 = wl_registry#1.bind
zwp_linux_dmabuf_v1#1 = wl_registry#1.bind
  <- modifier(<the renderer's formats>)
zwp_text_input_manager_v3#1 = wl_registry#2.bind
  -> get_text_input(new zwp_text_input_v3#1, wl_seat#2)
zwp_text_input_v3#1 = zwp_text_input_manager_v3#1.get_text_input
  <- enter(wl_surface#2)
  <- leave(wl_surface#2)
  <- enter(wl_surface#1)
zxdg_decoration_manager_v1#1 = wl_registry#1.bind
  -> get_toplevel_decoration(new zxdg_toplevel_decoration_v1#1, xdg_toplevel#1)
  -> get_toplevel_decoration(new zxdg_toplevel_decoration_v1#2, xdg_toplevel#2)
zxdg_toplevel_decoration_v1#1 = zxdg_decoration_manager_v1#1.get_toplevel_decoration
  <- configure(2), before xdg_surface#1.configure[1]
zxdg_toplevel_decoration_v1#2 = zxdg_decoration_manager_v1#1.get_toplevel_decoration
  <- configure(2), before xdg_surface#2.configure[1]
